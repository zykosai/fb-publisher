BIKEBOT_DATA_DIR=data
BIKEBOT_CITY=Poznań
BIKEBOT_RADIUS_MIN=15
BIKEBOT_RADIUS_MAX=200
BIKEBOT_DEFAULT_DELAY_MINUTES=90
BIKEBOT_ACTION_DELAY_SECONDS=2.5
BIKEBOT_BETWEEN_POSTS_SECONDS=60
# Leave empty to use the ignored, project-local data/browser_profile folder.
# If set explicitly, the bot must have write access to the chosen folder.
BIKEBOT_BROWSER_PROFILE=
BIKEBOT_BROWSER_CHANNEL=chrome
# Background work has no visible browser. Manual login still opens a window.
BIKEBOT_HEADLESS=true
